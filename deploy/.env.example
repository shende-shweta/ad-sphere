# Required outside local development: at least 32 random characters.
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MINUTES=60
# Comma-separated origins allowed to call the API cross-origin (not needed when the UI is bundled).
APP_CORS_ALLOWED_ORIGINS=
# Seed demo users and data into an empty database.
APP_SEED_ENABLED=false
# H2 file database example; swap for a server database (add its JDBC driver to WORKSPACE).
DB_URL=jdbc:h2:file:/data/adsphere;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=
