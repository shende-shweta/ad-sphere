# Hermetic JDK 21 (registered in WORKSPACE); application bytecode targets Java 11.
build --java_runtime_version=remotejdk_21
build --tool_java_runtime_version=remotejdk_21
build --java_language_version=11
build --tool_java_language_version=11

# `--config=ui` builds the React bundle with the host's Node.js/npm.
build:ui --action_env=PATH
